<div class="auth-card">
  <div class="card border-0 shadow-sm">
    <div class="card-body p-4 p-lg-5">
      <div class="mb-4">
        <div class="eyebrow">Create account</div>
        <h2 class="h4 mb-1"><%= t('devise.registrations.sign_up') %></h2>
        <p class="text-muted mb-0">Регистрация займет меньше минуты.</p>
      </div>

      <%= form_for(resource, as: resource_name, url: registration_path(resource_name)) do |f| %>
        <%= devise_error_messages! %>

        <div class="row g-3">
          <div class="col-md-6">
            <%= f.label :name, class: "form-label" %>
            <%= f.text_field :name, autofocus: true, class: "form-control" %>
          </div>
          <div class="col-md-6">
            <%= f.label :last_name, class: "form-label" %>
            <%= f.text_field :last_name, class: "form-control" %>
          </div>
          <div class="col-12">
            <%= f.label :email, class: "form-label" %>
            <%= f.email_field :email, class: "form-control" %>
          </div>
          <div class="col-12">
            <%= f.label :password, class: "form-label" %>
            <% if @minimum_password_length %>
              <div class="text-muted small mb-1">(<%= @minimum_password_length %> <%= t('devise.registrations.characters_minimum') %>)</div>
            <% end %>
            <%= f.password_field :password, autocomplete: "off", class: "form-control" %>
          </div>
          <div class="col-12">
            <%= f.label :password_confirmation, class: "form-label" %>
            <%= f.password_field :password_confirmation, autocomplete: "off", class: "form-control" %>
          </div>
        </div>

        <div class="d-grid mt-4">
          <%= f.submit t('devise.registrations.sign_up'), class: "btn btn-primary btn-lg" %>
        </div>
      <% end %>

      <%= render "devise/shared/links" %>
    </div>
  </div>
</div>
