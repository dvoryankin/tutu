<h1>Shopping Cart</h1>

<% if @cart.empty? %>
  <div class="alert alert-info">
    Your cart is empty. <%= link_to "Search for tickets", search_path %> to start booking.
  </div>
<% else %>
  <div class="row">
    <div class="col-md-8">
      <div class="card">
        <div class="card-header">
          <h5 class="mb-0">Cart Items (<%= @cart.items_count %>)</h5>
        </div>
        <ul class="list-group list-group-flush">
          <% @cart_items.each do |item| %>
            <li class="list-group-item d-flex justify-content-between align-items-center">
              <div>
                <h6 class="mb-1"><%= item.ticket.vehicle&.display_name %></h6>
                <p class="mb-1 text-muted">
                  <%= item.ticket.vehicle&.route&.name %><br>
                  Seat: <%= item.ticket.seat&.full_seat_number %> (<%= item.ticket.seat&.seat_type&.titleize %>)<br>
                  Passenger: <%= item.ticket.passenger_name %>
                </p>
              </div>
              <div class="text-end">
                <strong><%= number_to_currency(item.price, unit: 'RUB ') %></strong><br>
                <%= button_to "Remove", remove_item_cart_path(ticket_id: item.ticket.id),
                    method: :delete, class: "btn btn-outline-danger btn-sm mt-2",
                    data: { confirm: "Are you sure?" } %>
              </div>
            </li>
          <% end %>
        </ul>
      </div>
    </div>

    <div class="col-md-4">
      <div class="card">
        <div class="card-header">
          <h5 class="mb-0">Order Summary</h5>
        </div>
        <div class="card-body">
          <div class="d-flex justify-content-between mb-2">
            <span>Items:</span>
            <span><%= @cart.items_count %></span>
          </div>
          <hr>
          <div class="d-flex justify-content-between mb-3">
            <strong>Total:</strong>
            <strong><%= number_to_currency(@cart.total_amount, unit: 'RUB ') %></strong>
          </div>
          <%= button_to "Proceed to Checkout", checkout_cart_path, method: :post, class: "btn btn-primary w-100" %>
        </div>
      </div>
    </div>
  </div>
<% end %>
