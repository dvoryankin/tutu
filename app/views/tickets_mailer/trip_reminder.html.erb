<!DOCTYPE html>
<html>
<head>
  <meta charset="utf-8">
</head>
<body>
  <h1>Trip Reminder</h1>

  <p>Dear <%= @user.full_name %>,</p>

  <p>This is a reminder that your trip is scheduled for tomorrow!</p>

  <h2>Trip Details</h2>
  <div style="border: 1px solid #ccc; padding: 15px; margin: 10px 0;">
    <p><strong>Vehicle:</strong> <%= @ticket.vehicle&.display_name %></p>
    <p><strong>Route:</strong> <%= @ticket.route_name %></p>
    <p><strong>Seat:</strong> <%= @ticket.seat&.full_seat_number %></p>
    <p><strong>Passenger:</strong> <%= @ticket.passenger_name %></p>
    <p><strong>Departure:</strong> <%= @departure_time&.strftime('%d.%m.%Y %H:%M') %></p>
  </div>

  <h2>Important Reminders</h2>
  <ul>
    <li>Please arrive at the station/airport at least 30 minutes before departure</li>
    <li>Don't forget to bring your ID/passport</li>
    <li>Keep your ticket confirmation handy</li>
  </ul>

  <p>Have a great trip!</p>
  <p>TUTU Team</p>
</body>
</html>
