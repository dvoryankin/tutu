<h1>My Profile</h1>

<div class="row">
  <div class="col-md-8">
    <div class="card mb-4">
      <div class="card-header d-flex justify-content-between align-items-center">
        <h5 class="mb-0">Personal Information</h5>
        <%= link_to "Edit", edit_profile_path, class: "btn btn-outline-primary btn-sm" %>
      </div>
      <div class="card-body">
        <div class="row">
          <div class="col-md-6 mb-3">
            <label class="text-muted">Full Name</label>
            <p class="mb-0"><%= @user.full_name %></p>
          </div>
          <div class="col-md-6 mb-3">
            <label class="text-muted">Email</label>
            <p class="mb-0"><%= @user.email %></p>
          </div>
          <div class="col-md-6 mb-3">
            <label class="text-muted">Phone</label>
            <p class="mb-0"><%= @user.phone || 'Not set' %></p>
          </div>
          <div class="col-md-6 mb-3">
            <label class="text-muted">Date of Birth</label>
            <p class="mb-0"><%= @user.date_of_birth&.strftime('%d.%m.%Y') || 'Not set' %></p>
          </div>
        </div>
      </div>
    </div>

    <div class="card">
      <div class="card-header">
        <h5 class="mb-0">Travel Documents</h5>
      </div>
      <div class="card-body">
        <div class="row">
          <div class="col-md-6 mb-3">
            <label class="text-muted">Passport Number</label>
            <p class="mb-0"><%= @user.passport_number || 'Not set' %></p>
          </div>
          <div class="col-md-6 mb-3">
            <label class="text-muted">Passport Expiry</label>
            <p class="mb-0"><%= @user.passport_expiry&.strftime('%d.%m.%Y') || 'Not set' %></p>
          </div>
        </div>
      </div>
    </div>
  </div>

  <div class="col-md-4">
    <div class="card mb-4">
      <div class="card-header">
        <h5 class="mb-0">Statistics</h5>
      </div>
      <ul class="list-group list-group-flush">
        <li class="list-group-item d-flex justify-content-between">
          <span>Upcoming Trips</span>
          <span class="badge bg-primary rounded-pill"><%= @upcoming_trips_count %></span>
        </li>
        <li class="list-group-item d-flex justify-content-between">
          <span>Past Trips</span>
          <span class="badge bg-secondary rounded-pill"><%= @past_trips_count %></span>
        </li>
      </ul>
    </div>

    <div class="card">
      <div class="card-header">
        <h5 class="mb-0">Quick Links</h5>
      </div>
      <div class="list-group list-group-flush">
        <%= link_to upcoming_profile_path, class: "list-group-item list-group-item-action" do %>
          Upcoming Trips
        <% end %>
        <%= link_to trips_profile_path, class: "list-group-item list-group-item-action" do %>
          Trip History
        <% end %>
        <%= link_to orders_path, class: "list-group-item list-group-item-action" do %>
          My Orders
        <% end %>
        <%= link_to favorite_routes_path, class: "list-group-item list-group-item-action" do %>
          Favorite Routes
        <% end %>
      </div>
    </div>
  </div>
</div>
