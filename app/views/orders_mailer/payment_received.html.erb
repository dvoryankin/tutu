<!DOCTYPE html>
<html>
<head>
  <meta charset="utf-8">
</head>
<body>
  <h1>Payment Received</h1>

  <p>Dear <%= @user.full_name %>,</p>

  <p>We have received your payment for order <strong><%= @order.order_number %></strong>.</p>

  <p><strong>Amount:</strong> <%= number_to_currency(@order.total_amount, unit: 'RUB ') %></p>
  <p><strong>Payment Method:</strong> <%= @order.payment_method&.titleize %></p>
  <p><strong>Paid At:</strong> <%= @order.paid_at&.strftime('%d.%m.%Y %H:%M') %></p>

  <p>Your tickets have been confirmed. You can view them in your profile.</p>

  <p>Thank you for choosing TUTU!</p>
</body>
</html>
