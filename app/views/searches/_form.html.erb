<%= form_for @search, url: search_path, method: :post do |f| %>
  <div class="row g-3 align-items-end">
    <div class="col-md-3">
      <label class="form-label">Transport Type</label>
      <%= f.select :transport_type, options_for_select(@transport_types.map { |t| [t.titleize, t] }, @search.transport_type), {}, class: "form-select", data: { transport_select: true } %>
    </div>
    <div class="col-md-3">
      <label class="form-label">From</label>
      <% station_options = @stations.map { |station| [station.display_name, station.id, { 'data-station-type': station.type }] } %>
      <%= f.select :start_station_id, options_for_select(station_options, @search.start_station_id), { prompt: "Select station" }, class: "form-select", data: { station_select: true } %>
    </div>
    <div class="col-md-3">
      <label class="form-label">To</label>
      <%= f.select :end_station_id, options_for_select(station_options, @search.end_station_id), { prompt: "Select station" }, class: "form-select", data: { station_select: true } %>
    </div>
    <div class="col-md-2">
      <label class="form-label">Date</label>
      <%= f.date_field :date, class: "form-control", value: @search.date || Date.today %>
    </div>
    <div class="col-md-1">
      <%= f.submit "Search", class: "btn btn-primary w-100" %>
    </div>
  </div>
<% end %>
