<h1><%= @vehicle.display_name %></h1>

<div class="row mb-4">
  <div class="col-md-6">
    <div class="card">
      <div class="card-header">
        <h5 class="mb-0">Vehicle Details</h5>
      </div>
      <div class="card-body">
        <p><strong>Type:</strong> <span class="badge bg-<%= vehicle_badge_color(@vehicle) %>"><%= @vehicle.type %></span></p>
        <p><strong>Number:</strong> <%= @vehicle.number %></p>
        <p><strong>Route:</strong> <%= @vehicle.route&.name || 'Not assigned' %></p>
        <p><strong>Current Station:</strong> <%= @vehicle.current_station&.title || 'Not set' %></p>
        <p><strong>Total Seats:</strong> <%= @vehicle.total_seats %></p>
        <p><strong>Available Seats:</strong> <%= @vehicle.available_seats %></p>
      </div>
      <div class="card-footer">
        <%= link_to "Edit", edit_admin_vehicle_path(@vehicle), class: "btn btn-primary" %>
        <%= link_to "Back", admin_vehicles_path, class: "btn btn-outline-secondary" %>
      </div>
    </div>
  </div>

  <div class="col-md-6">
    <div class="card">
      <div class="card-header d-flex justify-content-between align-items-center">
        <h5 class="mb-0">Compartments</h5>
        <%= link_to "Add Compartment", new_admin_vehicle_compartment_path(@vehicle), class: "btn btn-success btn-sm" %>
      </div>
      <ul class="list-group list-group-flush">
        <% @compartments.each do |compartment| %>
          <li class="list-group-item d-flex justify-content-between align-items-center">
            <div>
              <strong>#<%= compartment.number %></strong> - <%= compartment.class_type.titleize %><br>
              <small class="text-muted"><%= compartment.type %></small>
            </div>
            <div>
              <span class="badge bg-secondary"><%= compartment.available_seats_count %>/<%= compartment.total_seats %></span>
              <%= link_to "View", admin_compartment_path(compartment), class: "btn btn-sm btn-outline-primary" %>
            </div>
          </li>
        <% end %>
      </ul>
    </div>
  </div>
</div>
