<%= form_for [:admin, @vehicle] do |f| %>
  <% if @vehicle.errors.any? %>
    <div class="alert alert-danger">
      <ul class="mb-0">
        <% @vehicle.errors.full_messages.each do |message| %>
          <li><%= message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class="row">
    <div class="col-md-6">
      <div class="card">
        <div class="card-body">
          <div class="mb-3">
            <%= f.label :type, class: "form-label" %>
            <%= f.select :type, ['Train', 'Plane', 'Bus'], {}, class: "form-select" %>
          </div>
          <div class="mb-3">
            <%= f.label :number, class: "form-label" %>
            <%= f.text_field :number, class: "form-control" %>
          </div>
          <div class="mb-3">
            <%= f.label :route_id, "Route", class: "form-label" %>
            <%= f.collection_select :route_id, Route.all, :id, :name, { include_blank: "Select route" }, class: "form-select" %>
          </div>
          <div class="mb-3">
            <%= f.label :current_station_id, "Current Station", class: "form-label" %>
            <%= f.collection_select :current_station_id, Station.all, :id, :title, { include_blank: "Select station" }, class: "form-select" %>
          </div>
        </div>
        <div class="card-footer">
          <%= f.submit "Save", class: "btn btn-primary" %>
          <%= link_to "Cancel", admin_vehicles_path, class: "btn btn-outline-secondary" %>
        </div>
      </div>
    </div>
  </div>
<% end %>
