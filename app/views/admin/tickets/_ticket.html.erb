<tr>
  <% vehicle = ticket.transport_vehicle %>
  <% route = vehicle&.route %>
  <% start_station = ticket.start_station || route&.start_station %>
  <% end_station = ticket.end_station || route&.end_station %>
  <td><%= vehicle&.number || '—' %></td>
  <td><%= start_station&.title || '—' %></td>
  <td><%= end_station&.title || '—' %></td>
  <td><%= ticket.user.email %></td>
  <td>
    <%= ticket.passenger_name %><br>
    <%= ticket.passenger_passport %>
  </td>
  <td>
    <%= link_to 'Show', [:admin, ticket] %>
    <%= link_to 'Edit', edit_admin_ticket_path(ticket) %>
    <%= link_to 'Destroy', [:admin, ticket], method: :delete, data: { confirm: 'Are you sure?' } %>
  </td>
</tr>
